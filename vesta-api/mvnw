#!/bin/sh
set -eu

MAVEN_VERSION=3.9.11
MAVEN_BASE="${MAVEN_USER_HOME:-$HOME/.m2}/wrapper/dists/apache-maven-$MAVEN_VERSION"
MAVEN_HOME="$MAVEN_BASE/apache-maven-$MAVEN_VERSION"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  mkdir -p "$MAVEN_BASE"
  ARCHIVE="$MAVEN_BASE/apache-maven-$MAVEN_VERSION-bin.zip"
  if [ ! -f "$ARCHIVE" ]; then
    wget -q "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.zip" -O "$ARCHIVE"
  fi
  unzip -q -o "$ARCHIVE" -d "$MAVEN_BASE"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"

